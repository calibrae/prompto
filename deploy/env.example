# /etc/prompto/env — EnvironmentFile for the systemd service.

# Path to the host inventory TOML.
PROMPTO_INVENTORY=/etc/prompto.toml

# HTTP listen address. 0.0.0.0 for LAN access, 127.0.0.1 for localhost-only.
PROMPTO_BIND=0.0.0.0:6337

# Comma-separated Host-header allowlist (DNS rebinding protection).
# Defaults to localhost only — override to accept remote clients.
# Set to "*" to disable the check entirely (only behind a trusted proxy/firewall).
PROMPTO_ALLOWED_HOSTS=*

# Path to the ssh binary. Override only if the system ssh is not on PATH.
PROMPTO_SSH_BIN=ssh

# Default per-command timeout (seconds).
PROMPTO_DEFAULT_TIMEOUT_SECS=30

# Per-step timeout in the vm_stop fallback chain (seconds).
PROMPTO_STOP_VM_STEP_SECS=30

# Token-savings analytics — set to 0/false to disable usage tracking entirely.
PROMPTO_GAIN_ENABLED=true

# Append-only JSONL log of every tool invocation (for `prompto gain`).
PROMPTO_USAGE_LOG=/var/lib/prompto/usage.jsonl

# Audit log: one JSON record per tool call (who, what, where, decision,
# outcome). Always written. With PROMPTO_AUTH optional/required a call
# that can't be recorded is refused. Query with `prompto audit`.
#PROMPTO_AUDIT_LOG=/var/lib/prompto/audit.jsonl
# Group for an audit file prompto creates itself (prompto must be a member).
#PROMPTO_AUDIT_GROUP=prompto-audit

# Tracing level.
RUST_LOG=prompto=info

# Vault-backed sudo for hosts declaring sudo_password_vault_path.
# Use a PERIODIC token (vault token create -period=768h -orphan ...);
# prompto renews it at half its lease. Keep this file 0640 root:prompto.
#PROMPTO_VAULT_TOKEN=
#PROMPTO_VAULT_ADDR=http://127.0.0.1:8200
#PROMPTO_VAULT_MOUNT=secret
# Vault behind a private CA: PEM file with the CA cert(s) to trust.
#PROMPTO_VAULT_CACERT=/etc/prompto/vault-ca.pem

# Agent authentication: off (default) | optional | required.
# optional: calls without a valid token run as agent "anonymous".
# required: they get 401. Mint tokens with `prompto agent add <name>`.
#PROMPTO_AUTH=off
#PROMPTO_AGENTS=/etc/prompto/agents.toml
# Policy, enforced with optional/required (ignored with off). A missing
# file there means every call is refused. See deploy/policy.toml.example.
#PROMPTO_POLICY=/etc/prompto/policy.toml

# Tickets and approvals (policy approval = "ticket" | "human"). Unset = off:
# approval rules refuse their calls. Keys: base64 of >= 32 random bytes
# (`prompto ticket keygen`) in vault KV v2 (fields current, previous) or a
# 0600 file (current on line 1, previous on line 2). See the README.
# NOTHING AN AGENT CAN READ MAY HOLD THE KEY OR A TOTP SECRET: they are read
# from their own KV v2 mount, which only prompto's token may read (README,
# "Where the approval secrets live") — never from the sudo passwords' mount.
#PROMPTO_PRIVATE_MOUNT=prompto-private
#PROMPTO_TICKET_KEY_VAULT_PATH=ticket-key
#PROMPTO_TICKET_KEY_FILE=/etc/prompto/keys/ticket.key
# What agents can read in vault (prefixes on PROMPTO_VAULT_MOUNT, or
# <mount>:<prefix>). A ticket key or TOTP secret under one turns approvals
# off. Match it to your agents' real vault access (e.g. a read-only gateway).
#PROMPTO_AGENT_READABLE_VAULT_PREFIXES=prompto/,infra/
# Human approvers (`prompto approver add <name>`), and the record of used
# tickets and TOTP codes that survives restarts.
#PROMPTO_APPROVERS=/etc/prompto/approvers.toml
#PROMPTO_APPROVAL_STATE=/var/lib/prompto/approval-state

# Peers allowed to set X-Real-IP / X-Forwarded-For (self-targeting guard).
#PROMPTO_TRUSTED_PROXIES=127.0.0.1,::1

# Re-enable MCP sessions only for a client that truly needs Mcp-Session-Id.
#PROMPTO_LEGACY_SESSION_MODE=false
