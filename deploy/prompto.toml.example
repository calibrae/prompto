# /etc/prompto.toml — host inventory.
# Each [host.<name>] block is one machine prompto is allowed to talk to.
# Capabilities are an allowlist — a tool refuses if its capability isn't granted.
#
# IPs below use TEST-NET-1 (RFC 5737) — replace with your own.

[host.gpu-rig]
ip = "192.0.2.12"
mac = "aa:bb:cc:dd:ee:ff"
ssh_user = "admin"
ssh_key  = "/etc/prompto/keys/id_rsa"
ssh_port = 22
capabilities = ["wake", "exec", "sudo_exec", "virt"]

[host.workstation]
ip = "192.0.2.13"
ssh_user = "admin"
ssh_key  = "/etc/prompto/keys/id_rsa"
capabilities = ["exec", "sudo_exec"]

[host.hypervisor]
ip = "192.0.2.7"
ssh_user = "admin"
ssh_key  = "/etc/prompto/keys/id_rsa"
capabilities = ["exec", "virt"]

# Optional per-host fields:
#   platform = "linux"            # linux | macos | freebsd | windows
#   chassis = "vm"                # cold_iron (default) | vm — a vm is never WOL'd
#   hypervisor = "hypervisor"     # host with `virt` that runs this guest
#   aliases = ["other-name"]
#   sudo_password_vault_path = "hosts/sudo"   # needs PROMPTO_VAULT_TOKEN
#   request_id_env = "off"        # export | setenv | off — how PROMPTO_REQUEST_ID
#                                 # reaches remote commands. Default: export on
#                                 # linux/macos, setenv on freebsd/windows. Use
#                                 # "off" for keys restricted by command=, rrsync
#                                 # or git-shell; "setenv" for a non-POSIX shell.
