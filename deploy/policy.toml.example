# /etc/prompto/policy.toml — who may use which tool on which host
# (PROMPTO_POLICY). Enforced only with PROMPTO_AUTH=optional|required; with
# off it is not read. Missing file under optional/required = deny everything;
# so is a file that fails to parse on reload, until a valid one is loaded.
# Reload with SIGHUP (`systemctl reload prompto`); check with
# `prompto policy lint` and `prompto policy check --agent A --host H --tool T`.
#
# Rules are read top to bottom; the FIRST rule that matches a call decides
# (allow, with that rule's approval). No match = deny. Rules only grant.
#
#   agents   agent names or group:<g> (groups from agents.toml). No globs.
#            "anonymous" (no token, optional mode) and "local" (stdio) only
#            match by name.
#   hosts    inventory names or aliases, * ? globs, group:<g> (inventory
#            `groups`). Ignored for inventory_list, prompto_gain,
#            mcp_reconnect_hint, which target no host (they still need a
#            tools match).
#   tools    tool names, * ? globs.
#   sudo     false (default): grants ordinary calls only.
#            true: grants root-capable calls only — ssh_sudo_exec,
#            file_write with sudo=true, service_control, host_sleep,
#            service_logs, mcp_logs (and GET /log), vm_stop.
#            This gates prompto's OWN root paths. An exec grant (ssh_exec,
#            bash_exec, …) is a shell as ssh_user — root wherever that user
#            is root or has passwordless sudo (inventory nopasswd_sudo).
#   approval "none" (default) | "ticket" | "human". "ticket": the call needs
#            a ticket from POST /v1/precheck; "human": one from POST
#            /v1/approve (an approver's TOTP code). Without a ticket key
#            configured (PROMPTO_TICKET_KEY_*), such a rule refuses its calls.
#
# Policy only narrows: host capabilities still apply, and no rule can let an
# agent act on its own machine (the self-targeting guard runs first).

# Stricter rules first: sudo on the edge router needs a human.
[[rule]]
id = "infra-router-sudo"
agents = ["infra"]
hosts = ["router"]
tools = ["*"]
sudo = true
approval = "human"

# infra: everything, root included, everywhere else.
[[rule]]
id = "infra-all"
agents = ["infra"]
hosts = ["*"]
tools = ["*"]

[[rule]]
id = "infra-root"
agents = ["infra"]
hosts = ["*"]
tools = ["*"]
sudo = true

# Builders: shell and files on the build hosts, no root.
[[rule]]
id = "build-exec"
agents = ["group:build"]
hosts = ["group:build"]
tools = ["ssh_exec", "ssh_batch", "rsync_sync", "file_*", "host_status", "host_diagnose", "inventory_*"]

# Web ops: drive and read services on the web hosts (root-capable tools).
[[rule]]
id = "web-services"
agents = ["web-ops"]
hosts = ["group:web"]
tools = ["service_control", "service_logs"]
sudo = true

# Unauthenticated callers (PROMPTO_AUTH=optional) may only look.
[[rule]]
id = "anonymous-read"
agents = ["anonymous"]
hosts = ["*"]
tools = ["inventory_list", "inventory_get_host", "host_status"]
