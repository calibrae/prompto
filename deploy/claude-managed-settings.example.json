{
  "extraKnownMarketplaces": {
    "prompto": {
      "source": { "source": "directory", "path": "/opt/prompto/claude-plugin" }
    }
  },
  "enabledPlugins": {
    "prompto@prompto": true
  },
  "prependPlugins": ["cc-plugin-sec-default@builtin", "prompto@prompto"],
  "allowManagedModsOnly": true,
  "pluginConfigs": {
    "prompto@prompto": {
      "options": {
        "url": "https://prompto.example.com/mcp",
        "token_file": "~/.config/prompto/token",
        "servers": "prompto"
      }
    }
  }
}
